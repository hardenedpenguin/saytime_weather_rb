#!/bin/sh
set -e

# postinst script for saytime-weather-rb

if [ "$1" = "configure" ]; then
    # Create config directory if it doesn't exist
    if [ ! -d /etc/asterisk/local ]; then
        mkdir -p /etc/asterisk/local
        chown asterisk:asterisk /etc/asterisk/local
        chmod 755 /etc/asterisk/local
    fi
    
    # Install default config only if it doesn't exist
    CONFIG_FILE="/etc/asterisk/local/weather.ini"
    if [ ! -f "$CONFIG_FILE" ]; then
        if [ -f /usr/share/saytime-weather-rb/weather.ini ]; then
            install -m 644 /usr/share/saytime-weather-rb/weather.ini "$CONFIG_FILE"
            chown asterisk:asterisk "$CONFIG_FILE"
            echo "Installed default configuration file: $CONFIG_FILE"
        fi
    fi
    
    # Persistent cache (geocode, timezone, airports, GPS fix). Owned by asterisk so both
    # root cron runs and asterisk DTMF runs can update entries in place.
    CACHE_DIR="/var/cache/saytime-weather-rb"
    if [ ! -d "$CACHE_DIR" ]; then
        mkdir -p "$CACHE_DIR"
    fi
    chown asterisk:asterisk "$CACHE_DIR" 2>/dev/null || true
    chmod 755 "$CACHE_DIR"
    # Old releases kept caches in /tmp under fixed names; remove them (never follow links).
    for old in /tmp/saytime-geocode-*.json /tmp/saytime-timezone-*.json \
               /tmp/saytime-weather-ourairports.csv /tmp/saytime-weather-ourairports.csv.part \
               /tmp/saytime-weather-airports-maps.json /tmp/saytime-weather-airports-maps.json.part \
               /tmp/saytime-gps-fix.json /tmp/saytime-gps-fix.json.part; do
        if [ -f "$old" ] || [ -L "$old" ]; then
            rm -f "$old"
        fi
    done

    # Set ownership for all installed files
    if [ -d /usr/sbin ]; then
        chown asterisk:asterisk /usr/sbin/weather.rb /usr/sbin/saytime.rb 2>/dev/null || true
    fi
    
    if [ -d /usr/share/asterisk/sounds/en ]; then
        chown -R asterisk:asterisk /usr/share/asterisk/sounds/en/wx 2>/dev/null || true
        # Remove mistaken package a-m/p-m from en/ if stock digits/ copies exist
        for meridian in a-m p-m; do
            if [ -f "/usr/share/asterisk/sounds/en/digits/${meridian}.ulaw" ] \
               && [ -f "/usr/share/asterisk/sounds/en/${meridian}.ulaw" ]; then
                rm -f "/usr/share/asterisk/sounds/en/${meridian}.ulaw"
            fi
        done
    fi
    
    echo "saytime-weather-rb installed successfully."
    echo "Configuration file: $CONFIG_FILE"
    echo ""
    echo "Usage:"
    echo "  /usr/sbin/weather.rb <location> [v]"
    echo "  /usr/sbin/saytime.rb -l <location> -n <node_number>"
fi

#DEBHELPER#

